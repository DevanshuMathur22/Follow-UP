generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  doctor
  staff
}

enum PatientGender {
  Female
  Male
  Other
  Prefer_not_to_say
}

enum PatientStatus {
  active
  archived
}

model User {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  email               String    @unique
  password            String
  role                UserRole  @default(doctor)
  active              Boolean   @default(true)
  sessionVersion      Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  patientsCreated Patient[] @relation("PatientCreatedBy")
  patientsDeleted Patient[] @relation("PatientDeletedBy")

  @@index([role])
  @@index([active])
  @@map("users")
}

model Patient {
  id                   String         @id @default(auto()) @map("_id") @db.ObjectId
  patientCode          String         @unique
  fullName             String
  age                  Int?
  gender               PatientGender?
  dob                  DateTime?
  mobile               String
  whatsapp             String?
  address              String?
  city                 String?
  state                String?
  category             String         @default("Other")
  diagnosis            String?
  history              String?
  allergies            String?
  remarks              String?
  status               PatientStatus  @default(active)
  nextFollowUp         DateTime?
  createdById          String?        @db.ObjectId
  isDeleted            Boolean        @default(false)
  deletedAt            DateTime?
  deletedById          String?        @db.ObjectId
  statusBeforeDeletion PatientStatus?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  createdBy User? @relation("PatientCreatedBy", fields: [createdById], references: [id])
  deletedBy User? @relation("PatientDeletedBy", fields: [deletedById], references: [id])

  followUps     FollowUp[]
  prescriptions Prescription[]
  certificates  Certificate[]

  @@index([fullName])
  @@index([mobile])
  @@index([category])
  @@index([status])
  @@index([nextFollowUp])
  @@index([isDeleted])
  @@index([deletedAt])
  @@index([isDeleted, status, createdAt])
  @@map("patients")
}

model Category {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  name                 String   @unique
  followUpIntervalDays Int      @default(30)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([active])
  @@map("categories")
}

model FollowUp {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  patientId String  @db.ObjectId
  patient   Patient @relation(fields: [patientId], references: [id])

  dueDate DateTime

  type     String @default("call")
  priority String @default("medium")
  status   String @default("Scheduled")

  source String  @default("manual")
  notes  String?

  outcome     String?
  completedAt DateTime?

  assignedToId String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([dueDate])
  @@index([status])
  @@index([priority])
  @@map("followUps")
}

model Prescription {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  patientId String  @db.ObjectId
  patient   Patient @relation(fields: [patientId], references: [id])

  issuedAt   DateTime
  doctorName String?
  diagnosis  String?
  notes      String?

  attachmentName     String
  attachmentType     String
  attachmentSize     Int
  attachmentUrl      String
  attachmentPathname String

  createdById String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([issuedAt])
  @@index([createdAt])
  @@map("prescriptions")
}

model CertificateTemplate {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  code         String  @unique
  name         String
  title        String
  description  String?
  bodyTemplate String
  fields       Json?

  active  Boolean @default(true)
  version Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([name])
  @@map("certificateTemplates")
}

model Certificate {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  patientId String  @db.ObjectId
  patient   Patient @relation(fields: [patientId], references: [id])

  issuedAt DateTime

  templateId      String? @db.ObjectId
  templateCode    String
  templateName    String
  templateTitle   String
  templateVersion Int     @default(1)
  fieldValues     Json?

  purpose           String?
  illnessDuration   String?
  treatmentDuration String?
  validity          String?
  additionalDetails String?

  certificateText String

  patientName      String
  patientAge       Int?
  patientDiagnosis String?

  doctorName         String?
  doctorRegistration String?
  specialization     String?

  clinicName    String?
  clinicPhone   String?
  clinicEmail   String?
  clinicAddress String?

  createdById String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([issuedAt])
  @@index([createdAt])
  @@map("certificates")
}

model ActivityLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  module      String
  action      String
  title       String
  description String?
  patientId   String?  @db.ObjectId
  recordId    String?
  relatedPath String?
  actorId     String?  @db.ObjectId
  actorName   String?
  actorRole   String?
  createdAt   DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([module, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("activityLogs")
}
